# Server-only settings. Never copy these into dist or browser JavaScript.
PICPAC_AI_ENABLED=false
PICPAC_AUTH_SECRET=
PICPAC_AIAI_API_KEY=
# Optional AIAI.BY chat model for album design instructions (text only).
PICPAC_ASSISTANT_MODEL=
PICPAC_MODEL_GATEWAY_URL=
PICPAC_MODEL_GATEWAY_KEY=
PICPAC_EDIT_MODEL=Qwen-Image-Edit-2511
# Enables an available image-edit provider for document previews.
PICPAC_DOCUMENT_STUDIO_ENABLED=false
# Reuses PICPAC_AIAI_API_KEY via the OpenAI-compatible images/edits endpoint.
# Set to a model verified with a live edit (for example seedream-4-edit).
PICPAC_AIAI_DOCUMENT_EDIT_MODEL=
# Optional direct Qwen Studio adapter, Singapore Model Studio region.
PICPAC_DASHSCOPE_API_KEY=
PICPAC_DASHSCOPE_WORKSPACE_ID=
PICPAC_GENERATE_MODEL=
PICPAC_PUBLIC_ORIGIN=https://picpac-memories-studio.actionone118743.chatgpt.site
PICPAC_PORT=4173
PICPAC_DAILY_JOB_LIMIT=3
PICPAC_GLOBAL_DAILY_JOB_LIMIT=12
PICPAC_GLOBAL_CONCURRENCY=4
PICPAC_ALLOW_LOCAL_MODEL=false
