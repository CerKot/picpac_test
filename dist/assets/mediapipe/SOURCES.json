    "cpu_image_example": "const {FaceLandmarker}=await import('./assets/mediapipe/vision_bundle.mjs'); const landmarker=await FaceLandmarker.createFromOptions(vision,{baseOptions:{modelAssetPath:'./assets/mediapipe/face_landmarker.task',delegate:'CPU'},runningMode:'IMAGE',numFaces:1,minFaceDetectionConfidence:0.5,minFacePresenceConfidence:0.5,minTrackingConfidence:0.5,outputFaceBlendshapes:true,outputFacialTransformationMatrixes:true}); const result=landmarker.detect(decodedImageOrCanvas);",
    "video_example": "await landmarker.setOptions({runningMode:'VIDEO'}); // for each new decoded video frame only: const result=landmarker.detectForVideo(video,performance.now()); // strictly increasing timestamps in milliseconds; calls synchronous. Switch back with await landmarker.setOptions({runningMode:'IMAGE'}) before detect(still).",
    "blendshape_example": "const scores=Object.fromEntries((result.faceBlendshapes[0]?.categories||[]).map(c=>[c.categoryName,c.score])); // scores.eyeBlinkLeft, eyeBlinkRight, jawOpen, mouthSmileLeft, mouthSmileRight; missing != zero",
    "blendshape_keys": [
